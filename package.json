{
  "name": "wiz-experiments-tests",
  "private": true,
  "description": "Test tooling only. The experiments are built and deployed from the wiz.jock.pl app, not from this repo.",
  "scripts": {
    "test": "vitest run",
    "harness:build": "node tests/harness/build.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "26.1.0",
    "lucide-react": "^1.65.0",
    "next": "^15.5.28",
    "playwright": "^1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "postcss": "^8.5.32"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
